# Copy to .env and fill in values. Never commit .env to git.

DATABASE_URL=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
EMAIL=
EMAIL_PASS=

# Image uploads (required on Vercel production; optional locally — without it, saves to public/uploads/)
# In Vercel: Project → Settings → Environment Variables (auto-added when you connect a Blob store)
BLOB_READ_WRITE_TOKEN=
# Optional — usually set automatically by Vercel when Blob store is connected
# BLOB_STORE_ID=
# BLOB_WEBHOOK_PUBLIC_KEY=

# Stripe (donations)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=
STRIPE_LINK_FORM=
WEBHOOK_SECRET_KEY=
