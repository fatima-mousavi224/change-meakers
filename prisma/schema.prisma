generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String       @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  password      String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  role          Role          @default(USER)
  UserProfile   UserProfile?
  resetToken    String?
  resetTokenExpiry DateTime?
}

model Account {
  id                String  @id @default(cuid()) @map("_id")
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid()) @map("_id")
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Post {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  description    String
  author         String
  authorImage    Image?
  categoryId     String?    @db.ObjectId
  postImages     Image[]
  postDate       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  Category       Category?  @relation(fields: [categoryId], references: [id])
}
model Code {
 id             String    @id @default(auto()) @map("_id") @db.ObjectId
 verifyCode      String 
}


model Category {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Post      Post[]
}

model Donate {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  choseDonationType     String
  choseDonationAmount   String
  choseDonationTime     DonateTime @default(ONE_TIME)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Member {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  position    String
  description String
  avatar      Image[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PaymentInfo {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  first_name    String
  last_name     String
  email         String
  amount        Int
  donationFrequency String
  donationType      String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model UserProfile {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  userId      String  @db.ObjectId @unique
  email        String
  phone        String
  country      String
  city         String
  coverPhoto   Image[]
  profilePhoto Image[]

 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Customer {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  firstName String
  lastName  String
  email     String
  subject   String?
  message   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscribers {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String   @id @map("_id")
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
model Project {
  id                         String                @id @default(auto()) @map("_id") @db.ObjectId
  // Card components
  projectTitle               String
  cardDescription            String
  uploadCardImage            String

  // Hero section
  heroTitle                  String?
  subheading                 String?
  slogan                     String?
  buttonName                 String?
  buttonLink                 String?
  heroImage                  String[]
  
  
  // Vision & Goal Section
  visionTitle                String?
  visionText                 String?
  goalTitle                  String?
  goalText                   String?
  visionGoalImage1           String?
  visionGoalImage2           String?
  visionGoalImage3           String?
  visionGoalImage4           String?
  // About Program Section
  sectionTitleAbout          String?
  bodyText                   String?
  buttonName2                String?
  buttonLink2                String?
  // Voices Section
  sectionTitleVoices         String?
  sectionDescriptionVoices   String?
  // Media Block Section
  heroTitleMedia             String?
  shortDescriptionMedia      String?
  videoLink                  String?
  fullVideoDescription       String?
  // Team Section
  sectionTitleTeam           String?
  sectionDescriptionTeam     String?
  // Students Section
  sectionTitleStudents       String?
  sectionDescriptionStudents String?
  // Quotation Section
  addQuote                   String?
  nameRole                   String?
  // Photo Album Section
  sectionTitlePhoto          String?
  sectionDescriptionPhoto    String?
 
  // Newsletter Section
  sectionTitleNewsletter     String?
  sectionDescriptionNewsletter String?
  // Global Goals (SDGs) Section
  sectionTitleSDGs           String?
  sectionTextSDGs            String?
  sdgsImage1                 String?
  sdgsImage2                 String?
  sdgsImage3                 String?
  sdgsImage4                 String?
  // Final Call to Action
  finalStatement             String?
  // Navigation
  navigationLabel            String?
  showInMainNavigation       Boolean            @default(true)
  // Card and Hero Images
  
  
  // Relations
  statusAndIcons          StatusAndIcon[]
  teamCards                  TeamCard[]
  studentItems               StudentItem[]
  voices                     Voice[]
  liveMoments                LiveMoment[]
  relatedLinks               RelatedLink[]
  newsletterItems            NewsletterItem[]
  offerIcons                 OfferIcon[]
  photoAlbums                 PhotoAlbum[]
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt
}

model PhotoAlbum {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  projectId   String      @db.ObjectId
  image       String
  title       String?
  description String?
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StatusAndIcon {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  projectId   String      @db.ObjectId
  iconTitle   String
  shortDescription String
  statusIcon String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TeamCard {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  projectId     String      @db.ObjectId
  name          String
  role          String
  biography     String
  link          String?
  showLinkInput Boolean  @default(false)
  image         String?
  icon          String?
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model StudentItem {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  projectId     String      @db.ObjectId
  name          String
  role          String
  biography     String
  link          String?
  showLinkInput Boolean  @default(false)
  image         String?
  icon          String?
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Voice {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  projectId   String      @db.ObjectId
  quote       String?
  name        String?
  location String?
  icon        String?
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LiveMoment {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  projectId   String      @db.ObjectId
  link        String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RelatedLink {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  projectId   String      @db.ObjectId
  buttonName  String
  buttonLink  String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NewsletterItem {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  projectId   String      @db.ObjectId
  date        DateTime
  title       String
  description String
  url         String?
  newsLetterImage String?
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OfferIcon {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  projectId   String      @db.ObjectId
  url         String
  iconTitle   String
  shortDescription String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}



model Impact {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  standardImpacts       StandardImpact[]
  highlightedImpacts    HighlightedImpact[]
  // Project association
  projectName           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model StandardImpact {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  impactId              String   @db.ObjectId
  title                 String
  impactTags            String
  writersName           String
  date                  DateTime
  contentDescription    String
  writerPhoto           String?
  galleryPhoto          String[]
  
  impact                Impact   @relation(fields: [impactId], references: [id], onDelete: Cascade)
}

model HighlightedImpact {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  impactId              String   @db.ObjectId
  message1              String?
  message2              String?
  title2                String?
  date2                 DateTime?
  impactTags2           String?
  writersName2          String?
  writerPhoto2          String?
  coverPhoto            String?
  galleryPhoto2         String[]
  contentDescription2   String?

  impact                Impact   @relation(fields: [impactId], references: [id], onDelete: Cascade)
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum Role {
  ADMIN
  USER
}

enum DonateTime {
  MONTHLY
  ONE_TIME
}

type Image {
  image String
}
