generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String       @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  password      String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  role          Role          @default(USER)
  UserProfile   UserProfile?
  resetToken    String?
  resetTokenExpiry DateTime?
}

model Account {
  id                String  @id @default(cuid()) @map("_id")
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid()) @map("_id")
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Post {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  description    String
  author         String
  authorImage    Image?
  categoryId     String?    @db.ObjectId
  postImages     Image[]
  postDate       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  Category       Category?  @relation(fields: [categoryId], references: [id])
}
model Code {
 id             String    @id @default(auto()) @map("_id") @db.ObjectId
 verifyCode      String 
}


model Category {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Post      Post[]
}

model Donate {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  choseDonationType     String
  choseDonationAmount   String
  choseDonationTime     DonateTime @default(ONE_TIME)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Member {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  position    String
  description String
  avatar      Image[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PaymentInfo {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  first_name    String
  last_name     String
  email         String
  amount        Int
  donationFrequency String
  donationType      String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model UserProfile {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  userId      String  @db.ObjectId @unique
  email        String
  phone        String
  country      String
  city         String
  coverPhoto   Image[]
  profilePhoto Image[]

 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Customer {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  firstName String
  lastName  String
  email     String
  subject   String?
  message   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscribers {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String   @id @map("_id")
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
model Project {
  id                         String                @id @default(auto()) @map("_id") @db.ObjectId
  projectTitle               String
  cardDescription            String
  heroTitle                  String
  iconTitleStatus1           String?
  shortDescriptionStatus1     String?
  iconTitleStatus2            String?
  shortDescriptionStatus2    String?
  sectionTitleVoices         String?
  sectionDescriptionVoices   String?
  sectionTitleTeam           String?
  sectionDescriptionTeam     String?
  sectionTitleStudents       String?
  sectionDescriptionStudents String?
  sectionTitleNewsletter     String?
  sectionDescriptionNewsletter String?
  navigationLabel            String?
  showInMainNavigation       Boolean            @default(true)
  cardImage                  String?
  heroImage                  String?
  newsletterImage1           String?
  newsletterImage2           String?
  statusIcon1                String?
  statusIcon2                String?
  teamCards                  TeamCard[]
  studentItems               StudentItem[]
  voices                     Voice[]
  liveMoments                LiveMoment[]
  relatedLinks               RelatedLink[]
  newsletterItems            NewsletterItem[]
  offerIcons                 OfferIcon[]
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt
}

model TeamCard {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  projectId     String      @db.ObjectId
  name          String
  role          String
  biography     String
  link          String?
  showLinkInput Boolean  @default(false)
  image         String?
  icon          String?
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model StudentItem {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  projectId     String      @db.ObjectId
  name          String
  role          String
  biography     String
  link          String?
  showLinkInput Boolean  @default(false)
  image         String?
  icon          String?
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Voice {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  projectId   String      @db.ObjectId
  quote       String
  name        String
  description String
  icon        String?
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LiveMoment {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  projectId   String      @db.ObjectId
  link        String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RelatedLink {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  projectId   String      @db.ObjectId
  buttonName  String
  buttonLink  String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NewsletterItem {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  projectId   String      @db.ObjectId
  date        DateTime
  title       String
  description String
  url         String?
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OfferIcon {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  projectId   String      @db.ObjectId
  url         String
  iconTitle   String?
  shortDescription String?
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum Role {
  ADMIN
  USER
}

enum DonateTime {
  MONTHLY
  ONE_TIME
}

type Image {
  image String
}
