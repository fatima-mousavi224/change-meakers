generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String?       @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  password      String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  role          Role          @default(USER)
  UserProfile   UserProfile?
  resetToken    String?
  resetTokenExpiry DateTime?
}

model Account {
  id                String  @id @default(cuid()) @map("_id")
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid()) @map("_id")
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Post {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  description    String
  author         String
  authorImage    Image?
  categoryId     String?    @db.ObjectId
  postImages     Image[]
  postDate       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  Category       Category?  @relation(fields: [categoryId], references: [id])
}
model Code {
 id             String    @id @default(auto()) @map("_id") @db.ObjectId
 verifyCode      String 
}


model Category {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Post      Post[]
}

model Donate {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  choseDonationType     String
  choseDonationAmount   String
  choseDonationTime     DonateTime @default(ONE_TIME)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Member {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  position    String
  description String
  avatar      Image[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PaymentInfo {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  first_name    String
  last_name     String
  email         String
  amount        Int
  donationFrequency String
  donationType      String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model UserProfile {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  userId      String  @db.ObjectId @unique
  email        String
  phone        String
  country      String
  city         String
  coverPhoto   Image[]
  profilePhoto Image[]

 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Customer {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  firstName String
  lastName  String
  email     String
  subject   String?
  message   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscribers {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String   @id @map("_id")
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum Role {
  ADMIN
  USER
}

enum DonateTime {
  MONTHLY
  ONE_TIME
}

type Image {
  image String
}
